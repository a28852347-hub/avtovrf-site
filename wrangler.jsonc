{
  "name": "empty-mountain-4a81",
  "main": "_worker.js",
  "compatibility_date": "2026-10-07",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/offer/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PROPOSALS",
        "class_name": "ProposalStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "proposals-v1",
      "new_sqlite_classes": [
        "ProposalStore"
      ]
    }
  ]
}
